# Environment Variables for Server
# Copy this file as .env and fill in your actual values

# Server Port
PORT=5000

# Environment
NODE_ENV=development

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/serveease

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Razorpay Payment Gateway
# Get keys from: https://dashboard.razorpay.com
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email Configuration (Brevo SMTP)
# Sign up free at: https://app.brevo.com
# Go to: SMTP & API → SMTP tab → Generate SMTP Key
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=your_brevo_smtp_login       # Found in Brevo SMTP settings (looks like: xxxxxxxx@smtp-brevo.com)
EMAIL_PASS=your_brevo_smtp_password    # Generated SMTP key (starts with: xsmtpsib-)
EMAIL_FROM=your_verified_email@gmail.com  # Must be verified in Brevo → Senders & IP

# ML Service URL (Python Flask)
ML_SERVICE_URL=http://localhost:5001
